            android:targetClass="com.studyos.app.MainActivity">
            <extra
                android:name="com.studyos.app.EXTRA_ROUTE"
                android:value="mistakes" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_today"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_today"
        android:shortcutShortLabel="@string/shortcut_today_short"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.studyos.app"
            android:targetClass="com.studyos.app.MainActivity">
            <extra
                android:name="com.studyos.app.EXTRA_ROUTE"
